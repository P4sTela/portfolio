---
import Layout from "../layouts/Layout.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { Image } from "astro:assets";
import avatar from "../assets/avatar.png";
---

<Layout title="About | P4sTela's Portfolio">
    <Header />
    <main class="pt-20 min-h-screen">
        <section class="py-20 px-4">
            <div class="max-w-3xl mx-auto">
                <h1 class="text-4xl font-bold mb-12">About</h1>
                <div class="prose prose-lg max-w-none">
                    <div class="flex">
                        <div class="flex-none">
                            <p class="text-base-content/80 mb-4">
                                P4sTelaです。インターネットに生息しています。
                            </p>
                            <p class="text-base-content/80 mb-4">
                                音楽を聴いたり、コードを書いています。たまに映像を作ります。
                            </p>
                            <p class="text-base-content/80 mb-8">
                                現在は修士課程と並行して、フリーランスのエンジニアとして活動しています。
                            </p>
                        </div>
                        <div class="w-36 rounded ml-auto">
                            <Image src={avatar} alt="Avatar" />
                        </div>
                    </div>

                    <h2 class="text-2xl font-bold mt-12 mb-6">所属</h2>

                    <div class="space-y-6">
                        <div class="card bg-base-200">
                            <div class="card-body">
                                <h3 class="card-title text-lg">学歴</h3>
                                <ul
                                    class="list-none space-y-3 text-base-content/80"
                                >
                                    <li class="flex items-center gap-3">
                                        <span
                                            class="badge badge-outline shrink-0"
                                            >卒業</span
                                        >
                                        <span>電気通信大学 情報理工学域</span>
                                    </li>
                                    <li class="flex items-center gap-3">
                                        <span
                                            class="badge badge-primary shrink-0"
                                            >在学中</span
                                        >
                                        <span
                                            >電気通信大学大学院 情報理工学研究科
                                            情報学専攻
                                            セキュリティ情報学プログラム</span
                                        >
                                    </li>
                                </ul>
                            </div>
                        </div>

                        <div class="card bg-base-200">
                            <div class="card-body">
                                <h3 class="card-title text-lg">サークル活動</h3>
                                <ul
                                    class="list-none space-y-2 text-base-content/80"
                                >
                                    <li>
                                        <span class="font-semibold"
                                            >バーチャルライブ研究会</span
                                        >
                                        <a
                                            href="https://www.mikuec.com"
                                            class="link link-info">mikuec.com</a
                                        >
                                        <p
                                            class="text-sm text-base-content/60 mt-1"
                                        >
                                            2021年から機材と音響に携わり、2023年度は副部長として活動
                                        </p>
                                        <p
                                            class="text-sm text-base-content/60 mt-1"
                                        >
                                            主にライブシステム開発やバーチャルライブの開発、映像制作などを行なった
                                        </p>
                                    </li>
                                    <li>
                                        <span class="font-semibold"
                                            >しれふぁら!</span
                                        >
                                        <p
                                            class="text-sm text-base-content/60 mt-1"
                                        >
                                            ボーカロイド創作サークル「しれふぁら！」の技術開発を担当、Webサイトの制作を行なう
                                        </p>
                                    </li>
                                    <li>
                                        <span class="font-semibold"
                                            >ビージーズ</span
                                        >
                                        <p
                                            class="text-sm text-base-content/60 mt-1"
                                        >
                                            動画を作ったり作らなかったり活動をしたりしていなかったりしています
                                        </p>
                                    </li>
                                </ul>
                            </div>
                        </div>

                        <div class="card bg-base-200">
                            <div class="card-body">
                                <h3 class="card-title text-lg">仕事</h3>
                                <ul
                                    class="list-none space-y-2 text-base-content/80"
                                >
                                    <li>
                                        <span class="font-semibold"
                                            >フリーランスエンジニア</span
                                        >
                                        <p
                                            class="text-sm text-base-content/60 mt-1"
                                        >
                                            Web開発を中心に活動中
                                        </p>
                                    </li>
                                </ul>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    </main>
    <Footer />
</Layout>
